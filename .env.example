# Copiar a .env y ajustar si se usa otro entorno.
# Demo pública compartida (puede reiniciarse en cualquier momento).
BASE_URL=https://automationintesting.online

# Credenciales públicas de demostración documentadas en
# https://github.com/mwinteringham/restful-booker-platform (no son secretos reales).
ADMIN_USER=admin
ADMIN_PASSWORD=password

# Número de workers (la prueba exige demostrar >= 2).
WORKERS=2

# Opcional: usar el Chrome instalado en lugar del Chromium de Playwright
# (útil si la red corporativa bloquea `npx playwright install`).
# BROWSER_CHANNEL=chrome
